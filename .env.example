APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:/NC6CNBiDJb2vV4fRviEsMqy5gKbePRgk44JGkZFAYY=
APP_DEBUG=true
APP_URL=http://localhost

# WhatsApp Vendor Concierge (use an HTTPS public origin in production)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_AI_PROVIDER=openai
WHATSAPP_AI_MODEL=gpt-4o-mini
WHATSAPP_MEDIA_DISK=local
QUEUE_CONNECTION_WHATSAPP=database
WHATSAPP_TEMPLATE_VENDOR_APPROVED=vendor_application_approved
WHATSAPP_TEMPLATE_VENDOR_DENIED=vendor_application_denied
# Set this after Meta approves vendor_application_denied_support. It includes Talk to Support.
# WHATSAPP_TEMPLATE_VENDOR_DENIED_SUPPORT=vendor_application_denied_support
WHATSAPP_TEMPLATE_VENDOR_SUSPENDED=vendor_store_suspended
WHATSAPP_TEMPLATE_VENDOR_UNSUSPENDED=vendor_store_reactivated
WHATSAPP_TEMPLATE_LOCALE=en
APP_MODE=dev

# The single hostname where the admin/vendor panel + all host routes live.
# Sub-domains and custom domains in tenant_domain_configs serve the
# storefront at root. Leave both unset for single-tenant / legacy installs.
APP_HOST_DOMAIN=
APP_HOST_BASE_DOMAIN=
APP_PUBLIC_IP=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mytijaara
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=database
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

REVERB_APP_ID=mytijaara
REVERB_APP_KEY=mytijaara
REVERB_APP_SECRET=mytijaara
REVERB_HOST="${APP_URL}"
REVERB_PORT=6001
REVERB_SCHEME=http

PUSHER_APP_ID=mytijaara
PUSHER_APP_KEY=mytijaara
PUSHER_APP_SECRET=mytijaara
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST="${APP_URL}"
PUSHER_PORT=6001
PUSHER_SCHEME=http

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
SOFTWARE_VERSION=4.0.1
